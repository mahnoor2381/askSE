# Copy this file to ".env" (never commit .env) and paste your key.
# After changing .env you MUST restart "npm run dev".

# Provider: "gemini" (default) or "openai" (any OpenAI-compatible API, e.g. Groq, OpenAI)
VITE_LLM_PROVIDER=gemini
VITE_LLM_API_KEY=PASTE_YOUR_KEY_HERE
VITE_LLM_MODEL=gemini-2.5-flash

# Only for provider=openai:
# VITE_LLM_BASE_URL=https://api.groq.com/openai/v1
# VITE_LLM_MODEL=llama-3.3-70b-versatile
